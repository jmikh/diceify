# Copy to .env.local (gitignored). All NEXT_PUBLIC_* values are inlined into the static bundle at build
# time (read in lib/env.public.ts) — never put a secret here. Cloudflare Pages sets the same four for
# preview/production builds.

# Local Supabase stack (`npm run db:start`; `npm run db:status` prints these). Ports are 5433x, see supabase/config.toml.
# The anon key below is the CLI's public demo key, identical on every machine.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Where the app is served (OAuth redirects, Stripe success/cancel URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Unset = Sentry inert.
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------------------------------
# Secrets live in two other gitignored files, NOT here:
#
# supabase/.env            read by `env(...)` in supabase/config.toml when the local stack starts
#   GOOGLE_CLIENT_ID=...apps.googleusercontent.com
#   GOOGLE_CLIENT_SECRET=...
#   (add http://127.0.0.1:54331/auth/v1/callback to the OAuth client's redirect URIs for local sign-in)
#
# supabase/functions/.env  used by `supabase functions serve` (D1); production via `supabase secrets set`
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...          (from `stripe listen`)
#   STRIPE_CREATOR_PRICE_ID=price_...        one-time $19
#   STRIPE_STUDIO_MONTHLY_PRICE_ID=price_... recurring $9/month
#   STRIPE_STUDIO_YEARLY_PRICE_ID=price_...  recurring $36/year
#   APP_URL=http://localhost:3000
