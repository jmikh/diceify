{
  "name": "diceify2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev",
    "dev:prod": "node --env-file=.env.prod.local node_modules/next/dist/bin/next dev",
    "build": "next build",
    "build:prod": "node --env-file=.env.prod.local node_modules/next/dist/bin/next build",
    "start": "next start",
    "pages:dev": "wrangler pages dev out",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p core && tsc -p functions",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:migration": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/database.types.ts",
    "db:types:prod": "supabase gen types typescript --linked --schema public > lib/supabase/database.types.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "functions:deploy": "supabase functions deploy",
    "functions:check": "deno check --config supabase/functions/deno.json supabase/functions/billing/index.ts supabase/functions/stripe-webhook/index.ts",
    "stripe:listen": "stripe listen --project-name diceify --forward-to http://127.0.0.1:54331/functions/v1/stripe-webhook",
    "gen-fixtures": "tsx scripts/gen-fixtures.ts",
    "migrate:legacy": "tsx scripts/migrate-from-prisma.ts"
  },
  "dependencies": {
    "@next/third-parties": "^14.2.35",
    "@sentry/nextjs": "^11.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "@use-gesture/react": "^10.3.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.542.0",
    "motion": "^12.23.12",
    "next": "^14.2.25",
    "react": "^18.3.1",
    "react-advanced-cropper": "^0.20.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "stripe": "20.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.0"
  }
}
