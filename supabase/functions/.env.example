# Copy to supabase/functions/.env (gitignored). Read by `npm run functions:serve`; hosted values are set with
# `supabase secrets set --env-file supabase/functions/.env.production` (see docs/DEPLOY.md). Test keys only locally:
# the functions refuse an sk_test_ key against a hosted SUPABASE_URL. SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are
# injected by the runtime and must not be set here.

STRIPE_SECRET_KEY=sk_test_...
# Printed by `npm run stripe:listen` (a new one per session); hosted: the dashboard endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CREATOR_PRICE_ID=price_...          # one-time $19 (the billing function refuses to boot without the three price ids)
STRIPE_STUDIO_MONTHLY_PRICE_ID=price_...   # recurring $9/month
STRIPE_STUDIO_YEARLY_PRICE_ID=price_...    # recurring $36/year
# Origin of the site: Checkout success_url (/account?checkout=success), cancel_url (/#pricing), portal return_url.
APP_URL=http://localhost:3000
