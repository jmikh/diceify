# Cloudflare static-asset headers (Workers assets, same syntax as Pages). All matching blocks apply; a later block
# overrides the same header from an earlier one. HTML stays on the platform default cache (no rule here).
# The CSP is Report-Only, never enforced: a static export needs 'unsafe-inline' for Next's inline scripts and styles.
# Sources: GA4 (@next/third-parties), PostHog (us.i / us-assets.i), Cloudflare Insights, Sentry ingest, Supabase (REST,
# Auth, Storage, Realtime), YouTube embeds in blog posts; img-src https: covers Supabase storage and Google avatars.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://us-assets.i.posthog.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://us.i.posthog.com https://us-assets.i.posthog.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://*.sentry.io https://cloudflareinsights.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'

# Hashed build output: immutable for a year
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Site images: 30 days, serve stale for a week while revalidating
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Icons: a week
/favicon.ico
